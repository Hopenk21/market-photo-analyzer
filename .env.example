# Example environment variables for Qwen integration
# Set these to enable server-side image analysis with Qwen 3 VL
QWEN_API_URL=https://api.example.com/v1/infer
QWEN_API_KEY=your_qwen_api_key_here

# Optional S3 settings (AWS or S3-compatible)
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_secret
