# Example environment variables for Qwen integration
# You can provide only the API key — the app will use a sensible default
# endpoint so you don't need to set `QWEN_API_URL` unless you prefer a
# custom provider URL.
QWEN_API_KEY=your_qwen_api_key_here
# Remote provider URL (required if you want remote analysis):
QWEN_API_URL=https://api.qwen.your-provider/v1/vision

# Optional S3 settings (AWS or S3-compatible)
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_secret

# Optional generic REST analysis endpoint (receives JSON with `image_base64`)
REST_ANALYSIS_URL=https://api.your-forex-analysis.com/v1/analyze
REST_ANALYSIS_KEY=your_rest_api_key_here
